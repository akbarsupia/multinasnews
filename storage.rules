rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Anyone can read images
      allow read: if true;
      // Only Admin can upload/delete (Sentinel Protocol)
      allow write: if request.auth != null && request.auth.token.email == 'multinasnews@gmail.com';
    }
  }
}
